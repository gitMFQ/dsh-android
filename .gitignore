# Build toolchain + caches (downloaded by build.sh, or laid out by CI)
.toolchain/

# Throwaway protocol probes. Deliberately not tracked: the durable record of what
# was verified, and how, belongs in docs/ — this directory is screenshots, UI
# dumps and one-off RPC probes that are worth exactly one debugging session.
.probe/

# Per-agent checkouts, each a copy of this tree with its own build/ output.
.work/

# Build serialisation. Held by flock, so the inode must survive; a tracked lock
# file would be rewritten by every checkout of it.
.build.lock
.install.lock
.device*.lock

# Gradle / Android
.gradle/
# Kotlin 2.x build session data written at the repo root by the compiler.
.kotlin/
build/
app/build/
local.properties
*.apk
*.keystore

# Editor
.idea/
*.iml
.DS_Store
.secrets/
__pycache__/
*.pyc

# Scratch file for `git commit -F`; never part of the repository.
.commitmsg.tmp

# Any other dotfile scratch note used to compose a commit or PR body. The pattern
# rather than one name each: two separate `git add -A` runs swept up `.pradd.md` and
# then `.cm.tmp`, and a third name would have done the same. Dotfile-only so a real
# markdown document at the repo root is never caught by it.
/.*.tmp
/.*.md.tmp
/.[a-z]*.md
!/.github/

# Tooling scratch (not project content)
.dsh/
