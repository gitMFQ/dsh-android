<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launcher icon's plate, which the platform draws on its own surface and
         is therefore not the app's window. Left as it was. -->
    <color name="ic_launcher_background">#0B0F14</color>

    <!--
      The fallback fill for the window, for the instant between the platform creating
      it and `WindowBackground.apply` painting it in the appearance the reader chose.

      It is the *dark* palette's `bgBase` (`#151517`), not the `#0B0F14` this used to
      be: those were two different colours describing the same surface, and the darker
      one was only ever right for nobody — a light or Monet reader got a flash of near
      black before a white app, and an AMOLED reader got it before a black one. A value
      here cannot follow the appearance (a resource is static), so it matches the case
      that is on screen longest and is corrected immediately by the runtime paint.
      See `docs/PHASE-2-PLAN.md` §1.5 and `ui/theme/WindowBackground.kt`.
    -->
    <color name="dsh_window_bg">#151517</color>

    <!--
      The widget's palette, which is the app's own dark theme (see
      ui/theme/DshTheme.kt) rather than anything the launcher supplies: a widget is
      inflated against the *launcher's* theme, so a theme attribute here would
      resolve to whatever the launcher happens to be and a light launcher would draw
      dark-on-dark. Kept as resources rather than literals in the renderer so a test
      can assert what was drawn against the same palette the layout uses.
    -->
    <color name="widget_background">#F2151517</color>
    <color name="widget_text_attention">#FFF59E0B</color>
    <color name="widget_text_quiet">#FFF9FAFB</color>
    <color name="widget_text_unknown">#FFADB2B8</color>
    <color name="widget_text_detail">#FFCFD3D6</color>
    <color name="widget_text_stamp">#FF81858C</color>
</resources>
